# Sin DATABASE_URL se habilita un demo ficticio, de solo lectura y sin envíos.
DATABASE_URL=
# URL pública final (sin / al final); localhost en desarrollo.
BETTER_AUTH_URL=http://localhost:3000
# Genera cada secreto por separado: openssl rand -hex 32
BETTER_AUTH_SECRET=
BOOKING_TOKEN_SECRET=
CRON_SECRET=

# Google OAuth; callback: /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo: dominio y remitente verificados en Resend.
RESEND_API_KEY=
EMAIL_FROM=GlowBook <reservas@tu-dominio.com>
# Cargas públicas para logos y galería (crear un store público en Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# WhatsApp Cloud API de Meta. Nunca se exponen al navegador.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# WhatsApp comercial de GlowBook: 57 + diez dígitos, sin + ni espacios.
NEXT_PUBLIC_SALES_WHATSAPP=

# Solo desarrollo. Seed explícito y no destructivo.
ALLOW_DEMO_SEED=false
# Bootstrap local; retirar estas variables tras crear la primera cuenta.
ADMIN_EMAIL=
ADMIN_NAME=Administradora
ADMIN_PASSWORD=
